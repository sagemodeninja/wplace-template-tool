{
    "compilerOptions": {
        "baseUrl": ".",
        "target": "ES2020",
        "module": "ESNext",
        // "outDir": "dist/scripts",
        "noImplicitAny": true,
        "moduleResolution": "node",
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "types": ["chrome"],
        "paths": {
            "@/*": ["scripts/*"]
        }
    },
    "include": ["scripts"]
}
